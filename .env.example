# Copy to .env for local/staging use. Keep real credentials out of Git.

# --- Discord bot -----------------------------------------------------------
# Same token, same application as the Shelfmark bot it replaces -- do not run
# both bots on this token at once (see README's "Why one bot").
DISCORD_BOT_TOKEN=replace-with-discord-bot-token

# --- Books, via the Shelfmark HTTP API (ported, unchanged behaviour) -------
# These four names are exactly what the current Shelfmark bot container
# already reads -- deployment is a drop-in replacement. DISCORDARR_API_URL /
# DISCORDARR_API_TOKEN / DISCORDARR_DISCORD_* aliases are also accepted (see
# README); the names below always win if both are set.
SHELFMARK_API_URL=http://shelfmark-api:8000
SHELFMARK_API_TOKEN=replace-with-a-long-random-token
SHELFMARK_DISCORD_GUILD_ID=replace-with-development-guild-id
# Comma-separated role IDs allowed to use ANY command in this bot (book and
# media alike). Empty means NOBODY may use the bot -- that is deliberate
# fail-closed behaviour, not a bug: a bot deployed before this is set must
# not let everyone on the server run every command.
SHELFMARK_DISCORD_ALLOWED_ROLE_IDS=
# Discord's own attachment cap is 10 MB on an unboosted server; raise this if
# the server is boosted. Affects /library type:ebook only.
SHELFMARK_DISCORD_MAX_ATTACHMENT_MB=10
# A /request release at or above this size (MB) asks for confirmation before
# it's queued, instead of queuing on the first Grab press.
SHELFMARK_DISCORD_LARGE_RELEASE_THRESHOLD_MB=5000

# --- Movies, via Radarr ------------------------------------------------------
# Optional -- leave unset and /movie replies that movies aren't set up here,
# rather than crashing or disappearing from the command list.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=replace-with-radarr-api-key
# Optional overrides. Left unset: the root folder is Radarr's only one (if it
# has more than one, /movie refuses with a config message instead of
# guessing); the quality profile is whichever one is MOST USED by movies
# already in the library, falling back to Radarr's first profile.
RADARR_ROOT_FOLDER=
RADARR_QUALITY_PROFILE=

# --- TV shows, via Sonarr -----------------------------------------------------
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=replace-with-sonarr-api-key
SONARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE=
# A show at or above either threshold stops for confirmation instead of
# being requested on the first press (a mis-ranked or simply huge show is
# one press away from every episode of it queuing at once). Sonarr's own
# search does not currently report a usable total-episode count (see
# README's "Response-shape notes"), so in practice only the season
# threshold fires today.
SONARR_BIG_SHOW_SEASON_THRESHOLD=5
SONARR_BIG_SHOW_EPISODE_THRESHOLD=100

# --- Music, via Lidarr (album-level requests) --------------------------------
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=replace-with-lidarr-api-key
LIDARR_ROOT_FOLDER=
LIDARR_QUALITY_PROFILE=
# Unlike the quality profile, this always has a value -- Lidarr ships
# "Standard" and "None" by default, and there is no sensible "most used"
# choice for a profile that mostly controls metadata matching, not quality.
LIDARR_METADATA_PROFILE=Standard
# Adding a brand-new artist only queues Lidarr's own metadata refresh; the
# requested album is not necessarily there yet on the very next read. These
# bound how long /music waits for it before giving up and saying so.
LIDARR_ALBUM_POLL_ATTEMPTS=5
LIDARR_ALBUM_POLL_SECONDS=2

# --- Shared by Radarr/Sonarr/Lidarr ------------------------------------------
DISCORDARR_ARR_HTTP_TIMEOUT_SECONDS=15
DISCORDARR_ARR_HTTP_RETRIES=2
# Per-Discord-user budget for /movie, /show and /music ADDS (not searches),
# shared across all three services -- modeled on Shelfmark's own rate
# limiting for grabs. A search never counts against this.
DISCORDARR_ADD_RATE_LIMIT_MAX=10
DISCORDARR_ADD_RATE_LIMIT_WINDOW_SECONDS=3600
